// Prisma schema — maps to existing `users` / `tasks` tables (snake_case columns).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique @db.VarChar(255)
  name           String    @db.VarChar(30)
  hashedPassword String    @map("hashed_password") @db.VarChar(255)
  roles          String?   @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  Task           Task[]
  Folder         Folder[]
  Backlog        Backlog[]

  @@map("users")
}

model Folder {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  User      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Task      Task[]

  @@map("folders")
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  isCompleted Boolean   @default(false) @map("is_completed")
  priority    String    @default("medium") @db.VarChar(10)
  trash       Boolean   @default(false)
  userId      Int       @map("user_id")
  folderId    Int?      @map("folder_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  User        User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Folder      Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  TaskLog     TaskLog[]

  @@unique([id, userId], map: "task_id_user_id_unique")
  @@map("tasks")
}

model TaskLog {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  message   String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  Task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("task_logs")
}

model Backlog {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(255)
  priority  String   @default("medium") @db.VarChar(10)
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("backlog")
}
